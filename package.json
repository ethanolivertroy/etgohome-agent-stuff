{
  "name": "etgohome-agent-stuff",
  "version": "0.0.1",
  "description": "Public agent skills, extensions, and prompts for Pi, Claude Code, Codex, and compatible Agent Skills runtimes.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "agent-skills",
    "pi",
    "codex",
    "security",
    "grc",
    "pi-extension",
    "subagents",
    "autoresearch",
    "tts",
    "web-search",
    "pi-skill",
    "pi-prompt",
    "claude-code",
    "claude-code-plugin"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills",
      "./pi/skills"
    ],
    "prompts": [
      "./pi/prompts"
    ]
  },
  "scripts": {
    "secrets:scan": "scripts/secret-scan.sh --working-tree",
    "secrets:scan-history": "scripts/secret-scan.sh --all",
    "secrets:install-hooks": "git config core.hooksPath .githooks",
    "linear:smoke": "node scripts/linear-mcp-smoke.mjs"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentui/core": "0.2.15",
    "@opentui/react": "0.2.15",
    "@sinclair/typebox": "^0.34.41",
    "jiti": "^2.7.0",
    "js-yaml": "^4.3.2",
    "marked": "^18.0.2",
    "react": "^19.2.0",
    "typebox": "^1.1.33"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethanolivertroy/etgohome-agent-stuff.git"
  }
}
