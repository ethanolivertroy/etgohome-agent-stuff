# Copy this file to .env and fill in real eMASS credentials locally.
# Do not commit .env, private keys, client certificates, or downloaded evidence.

# Required
export EMASSER_API_KEY=''
export EMASSER_HOST_URL=''
export EMASSER_KEY_FILE_PATH=''
export EMASSER_CERT_FILE_PATH=''
export EMASSER_KEY_FILE_PASSWORD=''

# Conditionally required by some eMASS deployments
export EMASSER_USER_UID=''

# Optional
export EMASSER_VERIFY_SSL='true'
export EMASSER_DEBUGGING='false'
export EMASSER_EPOCH_TO_DATETIME='false'
export EMASSER_DOWNLOAD_DIR='eMASSerDownloads'
